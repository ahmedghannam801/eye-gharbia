# ============================================================
# EYE Workflow Hub — E2E Test Environment Variables
# ============================================================
# Copy this file to .env.test and fill in your values.
# NEVER commit .env.test to git (it's already in .gitignore).
# ============================================================

# ── Application URL ──────────────────────────────────────────
# The URL to run tests against. Keep this at localhost:3000
# and run `npm run dev` before running tests.
TEST_BASE_URL=http://localhost:3000

# ── Supabase Credentials (same as .env) ──────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Test User Accounts ───────────────────────────────────────
# These accounts MUST be created manually in your Supabase
# Dashboard before running tests. They are dedicated test
# accounts and should NEVER be real user accounts.
#
# Required: Super Admin test account
E2E_ADMIN_EMAIL=test.admin@eye-test.org
E2E_ADMIN_PASSWORD=TestAdmin@EYE2026

# Required: Member test account (regular member)
E2E_MEMBER_EMAIL=test.member@eye-test.org
E2E_MEMBER_PASSWORD=TestMember@EYE2026

# Required: Leader test account (committee leader)
E2E_LEADER_EMAIL=test.leader@eye-test.org
E2E_LEADER_PASSWORD=TestLeader@EYE2026

# Required: Second member (for multi-user notification tests)
E2E_MEMBER_B_EMAIL=test.memberb@eye-test.org
E2E_MEMBER_B_PASSWORD=TestMemberB@EYE2026

# ── Test Data Configuration ───────────────────────────────────
# Prefix used to identify all test-created data
# (so it's never confused with real production data)
E2E_TEST_DATA_PREFIX=[E2E-TEST]
