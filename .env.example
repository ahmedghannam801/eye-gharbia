# GEMINI_API_KEY: Not used by this app's code (leftover from AI Studio scaffold).
# Safe to ignore / remove.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase project credentials (Settings > API in your Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is the public "anon" key - safe to expose in a browser app.
# Never put the "service_role" key here or in any client-side file.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ====================================================================
# EMAIL DELIVERY (Resend) — REQUIRED so issued certificates reach the
# recipient's inbox. Without these, the app still records the cert in
# the database and shows it on the recipient's profile, but the email
# step is skipped (and a warning is printed in the browser console).
#
# 1) Create a free account at https://resend.com
# 2) Verify the domain you want to send FROM (or use onboarding@resend.dev
#    for testing — limited to your own verified email address).
# 3) Generate an API key at https://resend.com/api-keys and paste it below.
# ====================================================================
VITE_RESEND_API_KEY=""
VITE_SENDER_EMAIL="onboarding@resend.dev"
